LOG_LEVEL=info
NODE_ENV=production
# Telegram Bot Settings
PUBLIC_URL="https://your-telegram-webhook-url.com/webhook"
TELEGRAM_TOKEN="paste-your-telegram-token-from-botfather"
PORT=3000
RATE_LIMIT=25
CONCURRENT_REQUESTS=3
# MySQL Database Settings
# DB_CONNECTION_STRING="mysql://root:rootpassword@localhost:3306/telegram_bot"
DB_HOST="127.0.0.1"
DB_USER="root"
DB_PASSWORD="rootpassword"
DB_NAME="telegram_bot"
#Redis Settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
